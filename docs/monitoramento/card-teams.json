{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    {
      "type": "Container",
      "style": "@{if(equals(items('Apply_to_each')?['situacao'],'resolvido'),'good',if(equals(items('Apply_to_each')?['situacao'],'nova-ocorrencia'),'warning','attention'))}",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "@{if(equals(items('Apply_to_each')?['situacao'],'resolvido'),'Resolvido',if(equals(items('Apply_to_each')?['situacao'],'nova-ocorrencia'),'Nova ocorrência','Novo problema'))} - @{body('Parse_JSON')?['computador']?['nome']}",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "@{items('Apply_to_each')?['problema']}",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Computador",
          "value": "@{body('Parse_JSON')?['computador']?['nome']}"
        },
        {
          "title": "Usuário",
          "value": "@{body('Parse_JSON')?['computador']?['usuario']}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Evidência",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "@{items('Apply_to_each')?['evidencia']}",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "O que fazer",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "@{items('Apply_to_each')?['solucao']}",
      "wrap": true
    }
  ]
}